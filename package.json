{
  "name": "kfz-document-linking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-worker.ps1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:polza": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-polza.ps1",
    "test:contract": "tsx --test tests/contracts.test.ts",
    "eval:links": "tsx scripts/evaluate-links.ts",
    "contracts:export": "tsx scripts/write-demo-fixtures.ts && tsx scripts/export-contract-schemas.ts",
    "demo:export": "tsx scripts/write-demo-result.ts",
    "deploy": "wrangler deploy",
    "test:polza:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-polza-full.ps1"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
